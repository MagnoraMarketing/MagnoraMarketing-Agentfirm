# ─────────────────────────────────────────────────────────────────────────────
# Magnora production environment. Copy to deploy/magnora/.env ON THE SERVER
# (never commit .env). `chmod 600 .env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── DEPLOYMENT ───────────────────────────────────────────────────────────────
# Domain that points (DNS A/AAAA record) at the server, e.g. ai.magnoramarketing.dk
PAPERCLIP_DOMAIN=
# Email Let's Encrypt uses for certificate expiry notices
ACME_EMAIL=

# ── DATABASE (Supabase project lwhyzhqwqxgryofdldzh) ─────────────────────────
# Supabase dashboard → Connect → copy the strings and insert the DB password.
# Application: Supavisor *transaction* pooler (port 6543).
DATABASE_URL=postgresql://postgres.lwhyzhqwqxgryofdldzh:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?sslmode=require
# Transaction pooler cannot keep prepared statements.
DATABASE_PREPARED_STATEMENTS=false
DATABASE_POOL_MAX=10
# Migrations: Supavisor *session* pooler (port 5432, IPv4) – or the direct
# connection db.lwhyzhqwqxgryofdldzh.supabase.co:5432 if the VM has IPv6.
DATABASE_MIGRATION_URL=postgresql://postgres.lwhyzhqwqxgryofdldzh:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require
# Apply pending migrations automatically on start (non-interactive server).
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# ── SECURITY ─────────────────────────────────────────────────────────────────
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32   (encrypts Paperclip Secrets – keep a copy offline!)
PAPERCLIP_SECRETS_MASTER_KEY=
PAPERCLIP_SECRETS_STRICT_MODE=true
# openssl rand -base64 48
PAPERCLIP_AGENT_JWT_SECRET=
# openssl rand -base64 48
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
# Set to true right after you have created your admin account (see README).
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
PAPERCLIP_AUTH_RATE_LIMIT_ENABLED=true

# ── AI PROVIDERS (used by the agent CLIs inside the container) ───────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Everything else (Google OAuth client secret, Meta/LinkedIn/X tokens,
# affiliate API tokens, GitHub tokens) is stored in Paperclip → Secrets via the
# browser – NOT in this file.
